#include <stdio.h> 

int main(void) {

    int age;  // Variable to store the person's age

    // Ask the user to enter their age
    printf("Enter the age in number: ");
    scanf("%d", &age);  // Read the age entered by the user

    // Check if the person is an infant (0-1 years)
    if (age >= 0 && age <= 1) {
        printf("The person is an Infant (0-1 years).");
    }

    // Check if the person is a toddler (2-3 years)
    else if (age > 1 && age <= 3) {
        printf("The person is a Toddler (2-3 years).");
    }

    // Check if the person is a child (4-12 years)
    else if (age > 3 && age <= 12) {
        printf("The person is a child (4-12 years).");
    }

    // Check if the person is a teenager (13-19 years)
    else if (age > 12 && age <= 19) {
        printf("The person is a teenager (13-19 years).");
    }

    // Check if the person is an adult (20-59 years)
    else if (age > 19 && age <= 59) {
        printf("The person is an adult (20-59 years).");
    }

    // Check if the person is a super senior citizen (80+ years)
    else if (age >= 80) {
        printf("The person is a super senior citizen (80+ years).");
    }

    // Check if the person is a senior citizen (60-79 years)
    else if (age >= 60) {
        printf("The person is a senior citizen (60-79 years).");
    }

    // Display an error message if the age is negative
    else {
        printf("Invalid age!");
    }

    return 0;  // End the program successfully
}

